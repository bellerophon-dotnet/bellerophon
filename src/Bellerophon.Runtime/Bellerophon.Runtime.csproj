<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fixed runtime code referenced by generated code: today, the OAuth scope check behind every generated access policy.
    Later: transactions, locks, sequencing, and the write-behind flusher.
  -->
  <PropertyGroup>
    <TargetFramework>$(BellerophonTargetFramework)</TargetFramework>
    <RootNamespace>Bellerophon.Runtime</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>The fixed server code Bellerophon's generated code calls: OAuth scope and identity claim checks, tenant membership authorization, the model contract (version and fingerprint, 426 on mismatch), the batch endpoint's request types, and service registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
