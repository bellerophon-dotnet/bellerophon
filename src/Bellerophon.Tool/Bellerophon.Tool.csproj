<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line tool: model validation today; baseline promotion, database migrations, release model-diff reports,
    and code metrics later.  Packaged as a .NET tool whose command is 'bell'.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BellerophonTargetFramework)</TargetFramework>
    <RootNamespace>Bellerophon.Tool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bell</ToolCommandName>
    <PackageId>Bellerophon.Tool</PackageId>
    <IsPackable>true</IsPackable>
    <Description>The bell command for Bellerophon models: bell validate &lt;path to bellerophon.json&gt; reports every model error with its line and column. Install with: dotnet tool install --global Bellerophon.Tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bellerophon.Modeling\Bellerophon.Modeling.csproj" />
  </ItemGroup>

</Project>
