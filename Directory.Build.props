<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>Tangent Atlas</Company>
    <Product>Bellerophon</Product>
    <Copyright>Copyright © Tangent Atlas. All rights reserved.</Copyright>
    <!--
      The target framework for everything that is not hosted by the compiler (the tool, samples, and tests).
      The generator and modeling projects stay on netstandard2.0 regardless.  Change this in one place.
    -->
    <BellerophonTargetFramework>net10.0</BellerophonTargetFramework>
    <!-- Report the naming rules in .editorconfig as build warnings, not only in the editor. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    NuGet packages.  Only the libraries in src/ that a consuming project references are packed (each sets IsPackable);
    samples and tests never are.  The version comes from the release tag (-p:Version=0.4.0 in the publish workflow), and
    0.4.0-dev otherwise, so a local pack can never be mistaken for a release.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.4.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Authors>Donald Airey</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bellerophon-dotnet/bellerophon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bellerophon-dotnet/bellerophon</RepositoryUrl>
    <PackageTags>source-generator;roslyn;code-generation;multi-tenant;in-memory;ledger</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
