<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Atlas Ledger server (the Primary role): the generated API over the in-memory ledger, write-behind persistence,
    the compliance engine, and the market data feed.  It runs until stopped; the client is a separate program.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BellerophonTargetFramework)</TargetFramework>
    <RootNamespace>AtlasLedger.Server</RootNamespace>
    <BellerophonRole>Primary</BellerophonRole>
    <!-- Write the generated files to obj/.../generated so they can be inspected, diffed, and archived with each release. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!--
    Stands in for the NuGet package reference, which imports this file automatically.  It includes the bellerophon.json in
    this folder: the server owns the model.
  -->
  <Import Project="..\..\src\Bellerophon.Generator\build\Bellerophon.Generator.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bellerophon.Generator\Bellerophon.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Bellerophon.Runtime\Bellerophon.Runtime.csproj" />
    <!-- Referencing the rules library makes Bellerophon generate LedgerRulesTenant and LedgerRuleActions. -->
    <ProjectReference Include="..\..\src\Bellerophon.Rules\Bellerophon.Rules.csproj" />
    <!-- Runs the compliance rules with NRules. -->
    <ProjectReference Include="..\..\src\Bellerophon.Rules.NRules\Bellerophon.Rules.NRules.csproj" />
    <!-- Referencing the SQL Server library makes Bellerophon generate LedgerSqlDatabase, the flusher's writer and the recovery loader. -->
    <ProjectReference Include="..\..\src\Bellerophon.SqlServer\Bellerophon.SqlServer.csproj" />
    <ProjectReference Include="..\TangentAtlas\TangentAtlas.csproj" />
  </ItemGroup>

</Project>
